# Dependencies
**/node_modules

# Build outputs
**/.nuxt
apps/application/.output
**/.turbo
packages/reporter/dist

# Local data
**/.data

# Environment & secrets
**/.env
**/.env.*
.npmrc

# Git, IDE
.git
.gitignore
.gitattributes
.idea
.vscode
**/.DS_Store

# Logs
**/*.log

# Docker
Dockerfile
.dockerignore
docker-compose.yml
docker-compose*.yml

# CI/CD
.github

# Hosting-platform manifests (read by the providers, not by the build)
deploy/
render.yaml
fly.toml
railway.json

# Docs — excluded, except what the server bundles for the MCP describe_piwi
# and get_release_notes tools (nuxt.config.ts → nitro.serverAssets): the docs
# pages, their snippets and the changelog. Generated pages stay out.
apps/docs/
**/*.md
!CHANGELOG.md
!apps/docs/index.md
!apps/docs/guide/**/*.md
!apps/docs/features/**/*.md
!apps/docs/recipes/**/*.md
!apps/docs/operate/**/*.md
!apps/docs/reference/**/*.md
!apps/docs/snippets/**
# The workflow skills, served by the MCP server as prompts.
!packages/reporter/templates/skills/*/SKILL.md
apps/docs/reference/analytics-widgets.md
apps/docs/reference/configuration.md
apps/docs/reference/features.md
apps/docs/reference/mcp-tools.md
apps/docs/reference/metrics.md
apps/docs/reference/reporter-options.md
apps/docs/reference/whats-new.md

# Tests (not needed for Docker build)
apps/application/tests/
**/test/
**/tests/
**/__tests__/
**/__snapshots__/
**/coverage/
**/.nyc_output

# Reporter (not needed for Docker build)
packages/reporter/src/
packages/reporter/dist/

# Source maps & declarations (dev artifacts)
**/*.map
**/*.tsbuildinfo

# Plans & local working docs
plans/
